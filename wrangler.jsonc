{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stan-website",
  "compatibility_date": "2026-08-06",

  // Aucun code serveur : ce Worker ne fait que servir le dossier `out/`
  // produit par `npm run build` (Next.js en export statique).
  "assets": {
    "directory": "./out",

    // Les URL inconnues renvoient out/404.html, avec le bon code HTTP,
    // au lieu de la page blanche par défaut.
    "not_found_handling": "404-page"
  }
}
