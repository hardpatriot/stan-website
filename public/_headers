# En-têtes servis par Cloudflare Pages.
# Ce fichier est copié tel quel à la racine du site au build.

# Next génère l'aperçu de partage sans extension de fichier. Sans cette ligne,
# Cloudflare le sert en application/octet-stream et WhatsApp, iMessage ou X
# refusent de l'afficher.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600

# Les fichiers versionnés par Next (hash dans le nom) ne changent jamais.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
